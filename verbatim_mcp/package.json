{
  "name": "verbatim_mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An agentic MCP server that correlates script intent with speech prosody, providing timestamped delivery mechanics corrections and real-world connector actions",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["nitrostack", "mcp", "speech-coach", "delivery", "widgets"],
  "author": "NexusWave",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.14",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.3.0",
    "pitchfinder": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
